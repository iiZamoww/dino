local function toggleSpeed()
    speedEnabled = not speedEnabled
    if speedEnabled then
        
        local currentDino = player.Character and player.Character.Name
        if currentDino then
            local baseSpeed = getDinoSpeed(currentDino)
            local multipliedSpeed = baseSpeed * currentMultiplier
            startWalkSpeedLoop(multipliedSpeed)
        end
        print("Speed ENABLED")
    else
        
        local currentDino = player.Character and player.Character.Name
        if currentDino then
            local baseSpeed = getDinoSpeed(currentDino)
            startWalkSpeedLoop(baseSpeed)
        end
        print("Speed DISABLED")
    end
end

