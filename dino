UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.V then
        mainFrame.Visible = not mainFrame.Visible
    end
    if input.KeyCode == Enum.KeyCode.T then
        local despawnRemote = ReplicatedStorage:FindFirstChild("shared/network/init@GlobalEvents")
        if despawnRemote then
            local despawnEvent = despawnRemote:FindFirstChild("despawn")
            if despawnEvent then
                despawnEvent:FireServer()
            end
        end
        stopWalkSpeedLoop()
    end
    if input.KeyCode == Enum.KeyCode.H then
        emergencyCFrame()
        local currentCFrame = player.Character.HumanoidRootPart.CFrame
        teleport(currentCFrame)
    end
    if input.KeyCode == Enum.KeyCode.X then
        emergencyCFrame()
        teleportToMouse()
    end
    if input.KeyCode == Enum.KeyCode.KeypadPlus then
        serverhop()
    end
    if input.KeyCode == Enum.KeyCode.KeypadMinus then
        rejoin()
    end
    if input.KeyCode == Enum.KeyCode.M then
        despawn()
        task.wait(0.5)
        teleport(savedCleanCFrame)
        print(savedCleanCFrame)
    end
    if input.KeyCode == Enum.KeyCode.G then
        toggleSpeed()
    end
    if input.KeyCode == Enum.KeyCode.Y then
        local originalDino = player.Character.Name
        local currentCFrame = player.Character.HumanoidRootPart.CFrame
        teleport(currentCFrame, "Giganotosaurus")
        task.wait(1)
        despawn()
        teleport(currentCFrame, originalDino)
    end
end)
