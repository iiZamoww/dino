local function serverhop()
    local servers = {}
    local req = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true")
    local body = game:GetService("HttpService"):JSONDecode(req)
    for i, v in pairs(body.data) do
        if v.playing < v.maxPlayers and v.id ~= game.JobId then
            table.insert(servers, v.id)
        end
    end
    if #servers > 0 then
        game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], game.Players.LocalPlayer)
    end
end

local function rejoin()
    if #game.Players:GetPlayers() <= 1 then
        game.Players.LocalPlayer:Kick("\nRejoining...")
        task.wait()
        game:GetService("TeleportService"):Teleport(game.PlaceId, game.Players.LocalPlayer)
    else
        game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, game.JobId, game.Players.LocalPlayer)
    end
end

local function pressKey(key, duration)
    duration = duration or 0.05
    local keyCode = type(key) == "string" and Enum.KeyCode[key] or key
    VIM:SendKeyEvent(true, keyCode, false, game)
    task.wait(duration)
    VIM:SendKeyEvent(false, keyCode, false, game)
end

local function despawn()
    local despawnRemote = ReplicatedStorage:FindFirstChild("shared/network/init@GlobalEvents")
    if despawnRemote then
        local despawnEvent = despawnRemote:FindFirstChild("despawn")
        if despawnEvent then
            despawnEvent:FireServer()
        end
    end
end

local function teleport(teleportTo, dinoToSpawn, shouldDespawn)
    local oldCameraCFrame = workspace.Camera.CFrame
    local dinoToSpawn = dinoToSpawn or player.Character.Name
    if shouldDespawn == true then
        despawn()
        if player.Character then
            task.wait()
        end
    end
    spawnRemote:FireServer(dinoToSpawn)
    local character = player.CharacterAdded:Wait()
    local hRoot = character:WaitForChild("HumanoidRootPart")
    pressKey("F")
    task.wait(0.1)
    workspace.Camera.CFrame = oldCameraCFrame
    hRoot.CFrame = teleportTo
    task.wait(0.1)
end

local pathsToCheck = {
    workspace["Map Assets"].Ambiances,
    workspace.AmbienceBoundaries

}

local function bring(playerToBring, shouldDespawn)
    local oldCameraCFrame = workspace.Camera.CFrame
    local currentCFrame = player.Character.HumanoidRootPart.CFrame
    local currentDino = player.Character.Name

    if shouldDespawn == true then
        despawn()
        if player.Character then
            task.wait()
        end
    end

    print("fired")
    spawnRemote:FireServer("DRex")
    print("spawned DRex")
    local character = player.CharacterAdded:Wait()
    local hRoot = character:WaitForChild("HumanoidRootPart")
    pressKey("F")
    task.wait(0.1)
    for i = 1, 40 do
        local currentTargetCFrame = playerToBring.Character.HumanoidRootPart.CFrame
        local behindCFrame = currentTargetCFrame * CFrame.new(0, 0, 15)
        hRoot.CFrame = behindCFrame
        task.wait(0.05)
    end
    print("teleported to user") 
    hRoot.CFrame = currentCFrame
    print("teleported back")
    task.wait(1)
    if shouldDespawn == true then
        despawn()
        if player.Character then
            task.wait()
        end
    end
    spawnRemote:FireServer(currentDino)
    local character = player.CharacterAdded:Wait()
    local hRoot = character:WaitForChild("HumanoidRootPart")
    print("changed back to original")
    pressKey("F")
    task.wait(0.1)
    workspace.Camera.CFrame = oldCameraCFrame
    hRoot.CFrame = currentCFrame
    print("teleported back to original")
end

local function teleportToMouse()
    local mouse = player:GetMouse()
    local camera = workspace.CurrentCamera
    
    local ray = Ray.new(camera.CFrame.Position, (mouse.UnitRay.Direction * 1000))
    
    local ignoreList = {player.Character}
    
    -- Only check parts in specific paths
    for _, path in ipairs(pathsToCheck) do
        if path then
            for _, part in ipairs(path:GetDescendants()) do
                if part:IsA("BasePart") then
                    if part.Transparency >= 0.5 or part.CanCollide == false then
                        table.insert(ignoreList, part)
                    end
                end
            end
        end
    end
    
    local hit, position = workspace:FindPartOnRayWithIgnoreList(ray, ignoreList)
    
    if position then
        teleport(CFrame.new(position), nil, true)
    end
end

local function processAmber()
    local currentCFrame = player.Character.HumanoidRootPart.CFrame
    local currentDino = player.Character.Name
    spawnRemote:FireServer("Velociraptor")
    task.wait(0.3)
    for _, child in ipairs(amberFolder:GetChildren()) do
        local hasParts = false
        for _, descendant in ipairs(child:GetDescendants()) do
            if descendant:IsA("BasePart") then
                hasParts = true
                break
            end
        end
        
        if hasParts then
            local proximityPrompt = child:FindFirstChildOfClass("Model").ProximityPrompt
            if proximityPrompt then

                proximityPrompt.HoldDuration = 0
                teleport(child.CFrame, "Velociraptor", false)
                task.wait(0.25)
                proximityPrompt:InputHoldBegin()
                task.wait(proximityPrompt.HoldDuration)
                proximityPrompt:InputHoldEnd()
            end
        end

        task.wait(2.5)
        teleport(currentCFrame, currentDino, true)
    end
end

