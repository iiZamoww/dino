-- SORTED DINOSAUR SYSTEM
---------------------------------------------------
local dinos = {}
local addedNames = {}

if selectionFolder then
    for _, obj in ipairs(selectionFolder:GetDescendants()) do
        if obj:IsA("Frame") then
            local textObject = obj:FindFirstChildWhichIsA("TextLabel", true) or obj:FindFirstChildWhichIsA("TextButton", true)
            if textObject and textObject.Text ~= "" then
                local dinoName = textObject.Text:lower()
                dinoName = dinoName:sub(1,1):upper() .. dinoName:sub(2)
                table.insert(dinos, dinoName)
            end
        end
    end
end

if #dinos == 0 then
    dinos = {"Gallimimus", "Suchomimus", "Titanosaurus", "Giganotosaurus", "Tyrannosaurus", "Triceratops", "Velociraptor", "Spinosaurus"}
end

table.sort(dinos, function(a, b) return a:lower() < b:lower() end)

for _, dinoName in ipairs(dinos) do
    if not addedNames[dinoName] then
        addedNames[dinoName] = true
        local baseSpeed = getDinoSpeed(dinoName)
        local multipliedSpeed = baseSpeed * currentMultiplier
        local canTeleport = teleportAllowed[dinoName] ~= nil
        local teleportSymbol = canTeleport and " ✓" or " X"
        local owned = isOwned(dinoName)
        local buttonColor = owned and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0)
        
        local button = Instance.new("TextButton")
        button.Size = UDim2.new(1, -5, 0, 35)
        button.BackgroundColor3 = buttonColor
        button.TextColor3 = Color3.new(1,1,1)
        button.Font = Enum.Font.SourceSansBold
        button.TextScaled = true
        button.Text = dinoName .. " (" .. baseSpeed .. " → " .. math.floor(multipliedSpeed * 10) / 10 .. ")" .. teleportSymbol
        button.Parent = leftScrolling
        button.BackgroundTransparency = 0.3
        
        -- Store button
        allDinoButtons[dinoName] = button
        
        button.MouseButton1Click:Connect(function()
            if owned then
                startWalkSpeedLoop(multipliedSpeed)
                local actualDinoName = dinoNameMapping[dinoName] or dinoName
                local currentCFrame = player.Character.HumanoidRootPart.CFrame
                teleport(currentCFrame, actualDinoName, true)
            else
                button.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                task.wait(0.2)
                button.BackgroundColor3 = buttonColor
            end
        end)
    end
end

