_G.keybindConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.V then
        mainFrame.Visible = not mainFrame.Visible
    end

    if input.KeyCode == Enum.KeyCode.T then
        local despawnRemote = ReplicatedStorage:FindFirstChild("shared/network/init@GlobalEvents")
        if despawnRemote then
            local despawnEvent = despawnRemote:FindFirstChild("despawn")
            if despawnEvent then
                despawnEvent:FireServer()
            end
        end
        stopWalkSpeedLoop()
    end

    if input.KeyCode == Enum.KeyCode.H then
        local currentCFrame = player.Character.HumanoidRootPart.CFrame
        teleport(currentCFrame, nil, true)
    end
    
    if input.KeyCode == Enum.KeyCode.X then
        teleportToMouse()
    end
    
    if input.KeyCode == Enum.KeyCode.KeypadPlus then
        serverhop()
    end
    
    if input.KeyCode == Enum.KeyCode.KeypadMinus then
        rejoin()
    end
    
    if input.KeyCode == Enum.KeyCode.G then
        toggleSpeed()
    end

    if input.KeyCode == Enum.KeyCode.Y then
        local originalDino = player.Character.Name
        local currentCFrame = player.Character.HumanoidRootPart.CFrame
        despawn()
        teleport(currentCFrame, "Giganotosaurus")
        task.wait(1)
        teleport(currentCFrame, originalDino, true)
    end

    if input.KeyCode == Enum.KeyCode.M then
        local originalDino = player.Character.Name
        local currentCFrame = player.Character.HumanoidRootPart.CFrame
        despawn()
        teleport(currentCFrame, "Therizinosaurus")
        task.wait(1)
        teleport(currentCFrame, originalDino, true)
    end

    if input.KeyCode == Enum.KeyCode.KeypadOne then
        local combatFolder = game:GetService("ReplicatedStorage")["ccb1ba18-1e9d-4bb5-86d2-ca2d9fc33e9c"]
        local attacker = false
        local attackerName = nil

        for _, users in ipairs(combatFolder:GetChildren()) do
            for _, descendant in ipairs(users:GetChildren()) do
                if descendant:IsA("ObjectValue") and descendant.Name == player.Name then
                    attacker = true
                    attackerName = users.Name
                    break
                end
            end
        end
        
        if attacker then
            local currentDino = player.Character.Name
            if Players[attackerName].Character then
                local attackerCFrame = Players[attackerName].Character.HumanoidRootPart.CFrame
                teleport(attackerCFrame, currentDino, true)
            else
                local attackerCFrame = Players[attackerName].Character.HumanoidRootPart.CFrame
                Players[attackerName].CharacterAdded:Wait()
                teleport(attackerCFrame, currentDino, true)
            end
        else
            print("No attacker found")
        end
    end

    if input.KeyCode == Enum.KeyCode.Insert then
        pingDisplayer.Visible = not pingDisplayer.Visible
        fpsDisplayer.Visible = not fpsDisplayer.Visible
    end

    if input.KeyCode == Enum.KeyCode.KeypadSix then
        local targetCFrame = CFrame.new(500, -200, 500)
        local currentDino = player.Character.Name
        teleport(targetCFrame, currentDino, true)
    end

    if input.KeyCode == Enum.KeyCode.C then
        if not velocityConnection then
            velocityConnection = RunService.Heartbeat:Connect(function()
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = player.Character.HumanoidRootPart
                    hrp.Velocity = Vector3.new(0, 0, 0)
                    hrp.RotVelocity = Vector3.new(0, 0, 0)
                end
            end)
        end
    end
end)

