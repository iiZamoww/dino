    dinos = {"Gallimimus", "Suchomimus", "Titanosaurus", "Giganotosaurus", "Tyrannosaurus", "Triceratops", "Velociraptor", "Spinosaurus"}
end

table.sort(dinos, function(a, b) return a:lower() < b:lower() end)

for _, dinoName in ipairs(dinos) do
    if not addedNames[dinoName] then
        addedNames[dinoName] = true
        local baseSpeed = getDinoSpeed(dinoName)
