local function updateDropdown(searchText)
    for _, child in ipairs(dropdown:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local matches = {}

    if searchText == "" then
        -- Show all players except yourself
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= Players.LocalPlayer then
                table.insert(matches, player.Name)
            end
        end
    else
        local searchLower = searchText:lower()

        for _, player in ipairs(Players:GetPlayers()) do
            if player.Name:lower():find(searchLower) and player ~= Players.LocalPlayer then
                table.insert(matches, player.Name)
            end
        end
    end
    
    table.sort(matches)
    
    if #matches > 0 then
        dropdown.Visible = true

        local buttonHeight = 30
        local padding = 2
        local totalHeight = #matches * (buttonHeight + padding)

        dropdown.Size = UDim2.new(1, -20, 0, 100)

        dropdown.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
        
        for _, name in ipairs(matches) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 30)
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            btn.TextColor3 = Color3.new(1,1,1)
            btn.Text = name
            btn.Font = Enum.Font.SourceSans
            btn.TextSize = 16
            btn.Parent = dropdown
            
            btn.MouseButton1Click:Connect(function()
                teleportTextBox.Text = name
                dropdown.Visible = false
            end)
        end
    else
        dropdown.Visible = false
    end
end

