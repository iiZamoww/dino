local function getDinoSpeed(dinoName)
    local success, DinoStatsModule = pcall(function()
        return require(ReplicatedStorage:WaitForChild("TS"):WaitForChild("config"):WaitForChild("dinosaur-stats"))
    end)
    
    if success and DinoStatsModule then
        local DinoStats = DinoStatsModule.default or DinoStatsModule
        for key, data in pairs(DinoStats) do
            if key:lower() == dinoName:lower() then
                return data.SprintSpeed or fallbackSpeeds[dinoName] or 16
            end
        end
    end
    return fallbackSpeeds[dinoName] or 16
end

