        button.Text = dinoName .. " (" .. baseSpeed .. " → " .. math.floor(multipliedSpeed * 10) / 10 .. ")" .. teleportSymbol
        button.Parent = leftScrolling
        button.BackgroundTransparency = 0.3
        
        button.MouseButton1Click:Connect(function()
            if owned then
                startWalkSpeedLoop(multipliedSpeed)
                local actualDinoName = dinoNameMapping[dinoName] or dinoName
                emergencyCFrame()
                local currentCFrame = player.Character.HumanoidRootPart.CFrame
                teleport(currentCFrame, actualDinoName)
            else
                button.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                task.wait(0.2)
                button.BackgroundColor3 = buttonColor
            end
        end)
    end
end

