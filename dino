-- WALKSPEED LOOP SYSTEM
---------------------------------------------------
local currentMultiplier = 2.7
local currentSpeed = 16
local wsLoopConnection = nil
local charAddedConnection = nil

local function setWalkSpeed(speed)
    local char = player.Character or workspace:FindFirstChild(player.Name)
    local human = char and char:FindFirstChildWhichIsA("Humanoid")
    if char and human then
        human.WalkSpeed = speed
        currentSpeed = speed
    end
end

local function startWalkSpeedLoop(speed)
    if wsLoopConnection then wsLoopConnection:Disconnect() end
    if charAddedConnection then charAddedConnection:Disconnect() end
    
    setWalkSpeed(speed)
    
    local function onWalkSpeedChanged()
        local char = player.Character or workspace:FindFirstChild(player.Name)
        local human = char and char:FindFirstChildWhichIsA("Humanoid")
        if char and human and human.WalkSpeed ~= currentSpeed then
            human.WalkSpeed = currentSpeed
        end
    end
    
    local char = player.Character or workspace:FindFirstChild(player.Name)
    local human = char and char:FindFirstChildWhichIsA("Humanoid")
    if char and human then
        wsLoopConnection = human:GetPropertyChangedSignal("WalkSpeed"):Connect(onWalkSpeedChanged)
    end
    
    charAddedConnection = player.CharacterAdded:Connect(function(newChar)
        local newHuman = newChar:WaitForChild("Humanoid")
        task.wait(0.1)
        newHuman.WalkSpeed = currentSpeed
        if wsLoopConnection then wsLoopConnection:Disconnect() end
        wsLoopConnection = newHuman:GetPropertyChangedSignal("WalkSpeed"):Connect(onWalkSpeedChanged)
    end)
end

local function stopWalkSpeedLoop()
    if wsLoopConnection then wsLoopConnection:Disconnect() end
    if charAddedConnection then charAddedConnection:Disconnect() end
end

